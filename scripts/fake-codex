#!/usr/bin/env python3
"""Deterministic stand-in for Codex CLI integration tests.

Set FAKE_CODEX_MODE to success, malformed, or failure. The success protocol uses
JSON Lines so callers can observe a progress event before a completed result.
"""

from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import sys


def outcome_direction(text: str) -> str | None:
    if "higher outcome" in text:
        return "higher"
    if "lower outcome" in text:
        return "lower"
    return None


def research(request_path: str, mode: str) -> int:
    if os.environ.get("RESEARCHOS_CHAT_ACCESS") != "readonly":
        print("research worker was not read-only", file=sys.stderr)
        return 70
    if os.environ.get("RESEARCHOS_NETWORK_ACCESS") != "enabled":
        print("research chat did not receive its live-web capability", file=sys.stderr)
        return 71
    request = json.loads(open(request_path, encoding="utf-8").read())
    vault = os.path.abspath(request["published_vault"])
    index_path = request.get("index_path")
    if index_path and os.path.exists(index_path):
        open(index_path, encoding="utf-8").read()
    for page in request.get("pages", []):
        open(page["file"], encoding="utf-8").read()
    source_ids: list[str] = []
    for derivative in request.get("derivatives", []):
        open(derivative["path"], encoding="utf-8").read()
        source_ids.append(derivative["source_id"])
    if mode == "prompt-write":
        try:
            open(os.path.join(vault, "injected.md"), "w", encoding="utf-8").write("no")
        except OSError:
            pass
        subprocess.run(
            ["git", "-C", vault, "commit", "--allow-empty", "-m", "prompt write"],
            check=False,
            capture_output=True,
            text=True,
        )
    if len(source_ids) >= 2:
        answer = (
            "The published lab evidence supports a cross-paper synthesis: the papers "
            "report complementary or contrasting findings that should remain separately cited. "
            f"Evidence: {source_ids[0]} and {source_ids[1]}."
        )
    elif source_ids:
        answer = f"The published lab evidence is currently limited to source {source_ids[0]}."
    else:
        answer = "No published lab evidence is available yet."
    # Deliberately not suitable for the UI: the application must map worker status
    # to concise public states rather than expose implementation details.
    print(json.dumps({"type": "progress", "message": "raw shell command: rg --hidden vault"}))
    if mode == "web":
        answer = (
            "The lab evidence establishes the starting point, while the external "
            "follow-up supplies the missing later evidence."
        )
        print(
            json.dumps(
                {
                    "type": "progress",
                    "scope": "external",
                    "message": "raw web tool invocation: search follow-up evidence",
                }
            )
        )
    print(json.dumps({"type": "answer", "content": "Synthesizing the published lab evidence. "}))
    output = {"answer": answer, "lab_source_ids": source_ids}
    if mode == "web":
        output.update(
            {
                "lab_evidence_gap": (
                    "The lab collection has no follow-up evidence for the later outcome."
                ),
                "external_sources": [
                    {
                        "title": "External follow-up study",
                        "url": "https://example.test/follow-up-study",
                    }
                ],
            }
        )
    print(
        json.dumps(
            {
                "type": "result",
                "output": json.dumps(output),
            }
        )
    )
    if mode == "result-failure":
        return 72
    return 0


def main() -> int:
    mode = os.environ.get("FAKE_CODEX_MODE", "success")
    if mode == "failure":
        print("controlled fake failure", file=sys.stderr)
        return 17
    if mode == "malformed":
        print("not-json")
        return 0
    if mode not in {"success", "invalid", "annotation", "artifact", "network", "drop-history", "missing-revision-link", "prompt-write", "result-failure", "web"}:
        print("unsupported fake Codex mode", file=sys.stderr)
        return 64
    if sys.argv[1:] == ["probe"]:
        print(json.dumps({"type": "progress", "message": "Checking the local worker"}))
        print(json.dumps({"type": "result", "output": "fake Codex is ready"}))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "research":
        return research(sys.argv[2], mode)
    if len(sys.argv) != 3 or sys.argv[1] != "ingest":
        print("unsupported fake Codex command", file=sys.stderr)
        return 64
    if os.environ.get("RESEARCHOS_NETWORK_ACCESS") != "disabled":
        print("writer networking was not disabled", file=sys.stderr)
        return 65
    request = json.loads(open(sys.argv[2], encoding="utf-8").read())
    source_id = request["source_id"]
    title = request["metadata"].get("title") or "Untitled paper"
    authors = request["metadata"].get("authors") or []
    year = request["metadata"].get("year")
    doi = request["metadata"].get("doi")
    revision_of = request.get("revision_of")
    source_text = open(request["derivative_path"], encoding="utf-8").read().casefold()
    substantive_method = "method" in source_text
    current_direction = outcome_direction(source_text)
    vault = os.path.abspath(request["staged_vault"])
    if not request.get("evidence_is_untrusted") or not os.path.abspath(sys.argv[2]).startswith(vault):
        print("invalid staged ingest request", file=sys.stderr)
        return 66
    if mode == "network":
        if sys.platform.startswith("linux"):
            capabilities = next(
                (
                    line.split(":", 1)[1].strip()
                    for line in open("/proc/self/status", encoding="utf-8")
                    if line.startswith("CapEff:")
                ),
                None,
            )
            if capabilities != "0000000000000000":
                print("writer retained Linux capabilities", file=sys.stderr)
                return 69
        try:
            socket.create_connection(("198.51.100.1", 9), timeout=0.1)
        except OSError:
            # A denied socket and a network namespace with no route are both
            # successful evidence that this writer cannot reach the network.
            pass
        else:
            print("writer unexpectedly reached the network", file=sys.stderr)
            return 68
    page_directory = os.path.join(vault, "papers")
    os.makedirs(page_directory, exist_ok=True)
    topic_directory = os.path.join(vault, "topics")
    os.makedirs(topic_directory, exist_ok=True)
    citation = f"source-{source_id[:12]}-p1"
    topic_path = os.path.join(topic_directory, "research-methods.md")
    existing_topic = (
        open(topic_path, encoding="utf-8").read() if os.path.exists(topic_path) else None
    )
    parent_path = os.path.join(page_directory, f"{revision_of}.md") if revision_of else None
    if parent_path and not os.path.exists(parent_path):
        print("revision parent has not been published", file=sys.stderr)
        return 67
    related_pages = (
        f"[[topics/research-methods|Research methods]] [^{citation}]"
        if substantive_method
        else "No related pages yet."
    )
    if revision_of:
        related_pages = f"[[papers/{revision_of}|Earlier revision]] [^{citation}]"
    author_text = "; ".join(authors) if authors else "Not specified"
    year_text = str(year) if year is not None else "Not specified"
    doi_text = doi or "Not specified"
    revision_metadata = (
        f"Revision of: [[papers/{revision_of}|Earlier revision]] [^{citation}]\n"
        if revision_of
        else ""
    )
    page = f'''---
page_type: paper
id: paper-{source_id}
title: {json.dumps(title)}
aliases: []
supporting_sources:
  - {source_id}
created: 2026-07-26
possible_duplicates: []
---
# {title}

## Bibliographic metadata
Title: {title} [^{citation}]
Authors: {author_text} [^{citation}]
Year: {year_text} [^{citation}]
DOI: {doi_text} [^{citation}]
{revision_metadata}

## Summary
This paper has been ingested as untrusted evidence. [^{citation}]

## Key findings
The paper reports a result that requires source-level review. [^{citation}]

## Methods
The method is recorded from the source derivative. [^{citation}]

## Datasets
Dataset details remain limited to the cited paper. [^{citation}]

## Limitations
The paper's limitations require cautious interpretation. [^{citation}]

## Related pages
{related_pages}

## Contradictions and open questions
No contradictions identified.

## Evidence citations
[^{citation}]: {title} — source {source_id} — PDF p. 1

## Researcher annotations
<!-- researcher-annotations:start -->
<!-- researcher-annotations:end -->
'''
    open(os.path.join(page_directory, f"{source_id}.md"), "w", encoding="utf-8").write(page)
    if revision_of:
        parent = open(parent_path, encoding="utf-8").read()
        revised_by = f"Revised by: [[papers/{source_id}|{title}]] [^{citation}]"
        parent = parent.replace("No related pages yet.", revised_by)
        if revised_by not in parent:
            parent = parent.replace("## Related pages\n", f"## Related pages\n{revised_by}\n")
        parent = parent.replace(
            "\n## Researcher annotations\n",
            f"\n[^{citation}]: {title} — source {source_id} — PDF p. 1\n\n## Researcher annotations\n",
        )
        open(parent_path, "w", encoding="utf-8").write(parent)
    existing_sources = (
        re.findall(r"— source ([0-9a-f]{64}) — PDF p\. \d+", existing_topic)
        if existing_topic
        else []
    )
    first_direction_match = (
        re.search(r"<!-- fake-claim-direction: (higher|lower) -->", existing_topic)
        if existing_topic
        else None
    )
    first_direction = first_direction_match.group(1) if first_direction_match else None
    historical_citations = "\n".join(
        line for line in (existing_topic or "").splitlines() if line.startswith("[^")
    )
    historical_claim_context = "\n".join(
        line
        for line in (existing_topic or "").splitlines()
        if not line.startswith("[^") and "[^" in line
    )
    contradiction = (
        substantive_method
        and bool(existing_sources)
        and {first_direction, current_direction} == {"higher", "lower"}
    )
    possible_duplicate = (
        substantive_method and bool(existing_sources) and "possible duplicate" in source_text
    )
    if substantive_method and not existing_sources:
        topic = f'''---
page_type: topic
id: topic-research-methods
title: "Research methods"
aliases: []
supporting_sources:
  - {source_id}
created: 2026-07-26
possible_duplicates: []
---
# Research methods

## Summary
Research methods are a substantive reusable method topic supported by this source. [^{citation}]

## Related evidence
[[papers/{source_id}|{title}]] [^{citation}]

## Evidence citations
[^{citation}]: {title} — source {source_id} — PDF p. 1

<!-- fake-claim-direction: {current_direction or 'unknown'} -->

## Researcher annotations
<!-- researcher-annotations:start -->
<!-- researcher-annotations:end -->
'''
        open(topic_path, "w", encoding="utf-8").write(topic)
    elif substantive_method:
        first_source = existing_sources[0]
        first_citation = f"source-{first_source[:12]}-p1"
        variant_path = os.path.join(topic_directory, "research-method-variants.md")
        if possible_duplicate:
            variant = f'''---
page_type: topic
id: topic-research-method-variants
title: "Research method variants"
aliases: []
supporting_sources:
  - {source_id}
created: 2026-07-26
possible_duplicates:
  - topics/research-methods
---
# Research method variants

## Summary
This separately maintained method page may describe the same method family. [^{citation}]

## Related pages
[[topics/research-methods|Research methods]] [^{citation}]

## Evidence citations
[^{citation}]: {title} — source {source_id} — PDF p. 1

## Researcher annotations
<!-- researcher-annotations:start -->
<!-- researcher-annotations:end -->
'''
            open(variant_path, "w", encoding="utf-8").write(variant)
        duplicate_metadata = (
            "possible_duplicates:\n  - topics/research-method-variants"
            if possible_duplicate
            else "possible_duplicates: []"
        )
        variant_link = (
            f"[[topics/research-method-variants|Research method variants]] [^{citation}]\n"
            if possible_duplicate
            else ""
        )
        contradiction_section = (
            "## Contradictions\n"
            f"[[papers/{first_source}|Earlier paper]] reports a {first_direction} outcome. [^{first_citation}]\n"
            f"[[papers/{source_id}|{title}]] reports a {current_direction} outcome. [^{citation}]\n\n"
            if contradiction
            else ""
        )
        possible_duplicate_section = (
            "## Possible duplicates\n"
            f"[[topics/research-method-variants|Research method variants]] remains separate pending identity confirmation. [^{citation}]\n\n"
            if possible_duplicate
            else ""
        )
        topic = f'''---
page_type: topic
id: topic-research-methods
title: "Research methods"
aliases: []
supporting_sources:
  - {first_source}
  - {source_id}
created: 2026-07-26
{duplicate_metadata}
---
# Research methods

## Summary
This substantive method topic accumulates evidence from two sources without collapsing their disagreement. [^{first_citation}] [^{citation}]

## Prior evidence
{historical_claim_context}

## Related evidence
[[papers/{source_id}|{title}]] [^{citation}]
{variant_link}

{contradiction_section}{possible_duplicate_section}## Evidence citations

{historical_citations}
[^{citation}]: {title} — source {source_id} — PDF p. 1

## Researcher annotations
<!-- researcher-annotations:start -->
<!-- researcher-annotations:end -->
'''
        open(topic_path, "w", encoding="utf-8").write(topic)
    with open(os.path.join(vault, "index.md"), "a", encoding="utf-8") as index:
        index.write(f"- [[papers/{source_id}]] — {title}\n")
        if substantive_method and "[[topics/research-methods]]" not in open(os.path.join(vault, "index.md"), encoding="utf-8").read():
            index.write("- [[topics/research-methods]] — Research methods\n")
        if possible_duplicate and "[[topics/research-method-variants]]" not in open(os.path.join(vault, "index.md"), encoding="utf-8").read():
            index.write("- [[topics/research-method-variants]] — Research method variants\n")
    with open(os.path.join(vault, "log.md"), "a", encoding="utf-8") as log:
        affected_pages = f"[[papers/{source_id}]]"
        if revision_of:
            affected_pages += f", [[papers/{revision_of}]]"
        if substantive_method:
            affected_pages += ", [[topics/research-methods]]"
        if possible_duplicate:
            affected_pages += ", [[topics/research-method-variants]]"
        log.write(
            f"\n## [2026-07-26] ingest | {title}\n"
            f"Source: {source_id}\nAffected pages: {affected_pages}\n"
            f"Contradictions: {1 if contradiction else 'none'}\n"
            f"Possible duplicates: {1 if possible_duplicate else 'none'}\nOutcome: published\n"
        )
    if mode == "invalid":
        open(os.path.join(page_directory, f"{source_id}.md"), "w", encoding="utf-8").write(
            "The staged writer intentionally returned malformed content.\n"
        )
    if mode == "drop-history" and existing_sources:
        first_source = existing_sources[0]
        topic = open(topic_path, encoding="utf-8").read()
        open(topic_path, "w", encoding="utf-8").write(
            topic.replace(f"source {first_source}", f"source {source_id}")
        )
    if mode == "missing-revision-link" and revision_of:
        revision_path = os.path.join(page_directory, f"{source_id}.md")
        revision = open(revision_path, encoding="utf-8").read()
        revision = revision.replace(f"[[papers/{revision_of}|Earlier revision]] ", "")
        open(revision_path, "w", encoding="utf-8").write(revision)
    if mode == "annotation":
        for filename in os.listdir(page_directory):
            if filename != f"{source_id}.md" and filename.endswith(".md"):
                path = os.path.join(page_directory, filename)
                contents = open(path, encoding="utf-8").read()
                open(path, "w", encoding="utf-8").write(
                    contents.replace(
                        "<!-- researcher-annotations:start -->\n",
                        "<!-- researcher-annotations:start -->\nunauthorized edit\n",
                    )
                )
                break
    if mode == "artifact":
        artifact = os.path.join(vault, "source.pdf")
        open(artifact, "wb").write(b"not a permitted wiki artifact")
        subprocess.run(["git", "-C", vault, "add", "source.pdf"], check=True)
    print(json.dumps({"type": "progress", "message": "Writing staged paper page"}))
    print(json.dumps({"type": "result", "output": "staged ingest complete"}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
